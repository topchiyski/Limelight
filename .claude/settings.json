{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run verify)",
      "Bash(npm run lint:guardrails)",
      "Bash(npm run test:list)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright show-report*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.dev)",
      "Read(./.env.staging)",
      "Read(./.env.prod)",
      "Read(./.auth/**)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
