# Copy to `.env` (shared defaults) and/or `.env.<TEST_ENV>` (per-environment overrides).
# Precedence: real process env > .env.<TEST_ENV> > .env

# local | dev | staging | prod   (prod excludes @mutates tests and blocks API writes)
TEST_ENV=local

# Web app under test
BASE_URL=http://localhost:3000

# REST API root. Optional — defaults to `${BASE_URL}/api/`
API_URL=

# Credentials for tests/setup/auth.setup.ts (UI login -> .auth/user.json)
USER_EMAIL=qa.user@example.test
USER_PASSWORD=change-me

# Optional bearer token sent as `Authorization: Bearer <token>` on every API call
API_TOKEN=
